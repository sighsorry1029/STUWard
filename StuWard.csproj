        <None Include="translations\Korean.yml">
          <Visible>true</Visible>
        </None>
        <Folder Include="translations\"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="STUWardServerSync" Version="1.0.1">
          <GeneratePathProperty>true</GeneratePathProperty>
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>compile;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="YamlDotNet" Version="16.3.0">
          <GeneratePathProperty>true</GeneratePathProperty>
        </PackageReference>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <Target Name="ValidateBuildEnvironment" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Text="Valheim game directory was not found. Set GamePath in environment.local.props or pass /p:GamePath=..." Condition="'$(GamePath)' == '' Or !Exists('$(GamePath)')"/>
        <Error Text="Valheim managed assemblies directory was not found: $(CorlibPath)" Condition="'$(CorlibPath)' == '' Or !Exists('$(CorlibPath)')"/>
        <Error Text="BepInEx directory was not found: $(BepInExPath)" Condition="'$(BepInExPath)' == '' Or !Exists('$(BepInExPath)')"/>
        <Error Text="Required reference assembly was not found: %(Reference.HintPath)" Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')"/>
    </Target>
    <!-- To modify your build process, add your task inside one of the targets below and uncomment it.
         Other similar extension points exist, see Microsoft.Common.targets.
    <Target Name="BeforeBuild">
    </Target>
    <Target Name="AfterBuild">
    </Target>
    -->
    <UsingTask AssemblyFile="KeyManager.dll" TaskName="KeyManager.Seal" Condition="'$(AfterTargets)' == 'KeyManager'"/>
    <Target Name="KeyManager" AfterTargets="ILRepack" Condition="'$(AfterTargets)' == 'KeyManager'">
        <Seal DLL="$(TargetPath)"/>
    </Target>
    <Target Name="GetAssemblyVersion" AfterTargets="$(AfterTargets)">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="Targets"/>
        </GetAssemblyIdentity>
        <ItemGroup>
            <AssemblyVersions Include="@(Targets->'%(Version)')"/>
        </ItemGroup>
        <Error Text="Failed to get Assembly Version." Condition="'%(AssemblyVersions.Identity)' == ''"/>
        <PropertyGroup>
            <AssemblyVersion>%(AssemblyVersions.Identity)</AssemblyVersion>
            <Major>$(AssemblyVersion.Split('.')[0])</Major>
            <Minor>$(AssemblyVersion.Split('.')[1])</Minor>
            <Patch>$(AssemblyVersion.Split('.')[2])</Patch>
            <PackageName>$(AssemblyName)_v$(Major).$(Minor).$(Patch)</PackageName>
            <PackageVersion>$(Major).$(Minor).$(Patch)</PackageVersion>
            <VersionString>$(Major).$(Minor).$(Patch)</VersionString>
            <PackageDir>$(ProjectDir)\Thunderstore\$(PackageName)</PackageDir>
        </PropertyGroup>
    </Target>
    <Target Name="DeployDebugToGame" AfterTargets="GetAssemblyVersion" Condition="'$(Configuration)' == 'Debug' And '$(DeployToGame)' == 'true'">
        <MakeDir Directories="$(GamePluginDeployPath)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePluginDeployPath)" OverwriteReadOnlyFiles="true"/>
        <Message Text="Deployed final Debug mod DLL to $(GamePluginDeployPath)\$(TargetFileName)" Importance="high"/>
    </Target>
    <Target Name="DeployLocal" DependsOnTargets="Build;GetAssemblyVersion;CopyOutputDLL;CopyPluginRuntimeContent"/>
    <Target Name="DeployLocalAfterBuild" AfterTargets="GetAssemblyVersion" Condition=" '$(DeployLocal)' == 'true' Or '$(DeployLocal)' == 'True' ">
        <CallTarget Targets="CopyOutputDLL;CopyPluginRuntimeContent"/>
    </Target>
    <Target Name="CopyOutputDLL">
        <Error Text="DLL not found in target directory." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <Error Text="No local deploy target configured. Set CopyOutputDLLPath in environment.local.props or pass it on the command line." Condition="'$(CopyOutputDLLPath)' == '' And '$(CopyOutputDLLPath2)' == '' And '$(CopyOutputDLLPath3)' == '' And '$(CopyOutputDLLPath4)' == ''"/>
        <MakeDir Directories="$(CopyOutputDLLPath)" Condition="'$(CopyOutputDLLPath)' != ''"/>
        <MakeDir Directories="$(CopyOutputDLLPath2)" Condition="'$(CopyOutputDLLPath2)' != ''"/>
        <MakeDir Directories="$(CopyOutputDLLPath3)" Condition="'$(CopyOutputDLLPath3)' != ''"/>
        <MakeDir Directories="$(CopyOutputDLLPath4)" Condition="'$(CopyOutputDLLPath4)' != ''"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath)" OverwriteReadOnlyFiles="true" Condition="'$(CopyOutputDLLPath)' != ''"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath2)" OverwriteReadOnlyFiles="true" Condition="'$(CopyOutputDLLPath2)' != ''"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath3)" OverwriteReadOnlyFiles="true" Condition="'$(CopyOutputDLLPath3)' != ''"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath4)" OverwriteReadOnlyFiles="true" Condition="'$(CopyOutputDLLPath4)' != ''"/>
    </Target>
    <Target Name="CopyPluginRuntimeContent">
        <ItemGroup>
            <RuntimeTranslationFiles Include="$(ProjectDir)translations\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(RuntimeTranslationFiles)"
              DestinationFiles="@(RuntimeTranslationFiles->'$(CopyOutputDLLPath)\translations\%(RecursiveDir)%(Filename)%(Extension)')"
              OverwriteReadOnlyFiles="true"
              SkipUnchangedFiles="true"
              Condition="'$(CopyOutputDLLPath)' != ''"/>
        <Copy SourceFiles="@(RuntimeTranslationFiles)"
              DestinationFiles="@(RuntimeTranslationFiles->'$(CopyOutputDLLPath2)\translations\%(RecursiveDir)%(Filename)%(Extension)')"
              OverwriteReadOnlyFiles="true"
              SkipUnchangedFiles="true"
              Condition="'$(CopyOutputDLLPath2)' != ''"/>
        <Copy SourceFiles="@(RuntimeTranslationFiles)"
              DestinationFiles="@(RuntimeTranslationFiles->'$(CopyOutputDLLPath3)\translations\%(RecursiveDir)%(Filename)%(Extension)')"
              OverwriteReadOnlyFiles="true"
              SkipUnchangedFiles="true"
              Condition="'$(CopyOutputDLLPath3)' != ''"/>
        <Copy SourceFiles="@(RuntimeTranslationFiles)"
              DestinationFiles="@(RuntimeTranslationFiles->'$(CopyOutputDLLPath4)\translations\%(RecursiveDir)%(Filename)%(Extension)')"
              OverwriteReadOnlyFiles="true"
              SkipUnchangedFiles="true"
              Condition="'$(CopyOutputDLLPath4)' != ''"/>
    </Target>
    <Target Name="CopyReadMeToTSFolder" AfterTargets="GetAssemblyVersion" Condition=" ('$(Configuration)|$(Platform)' == 'Release|AnyCPU') And ('$(OS)' == 'Windows_NT') ">
        <Error Text="README.md not found in project directory." Condition="!Exists('$(ProjectDir)README.md')"/>
        <Error Text="translations\English.yml not found in project directory." Condition="!Exists('$(ProjectDir)translations\English.yml')"/>
        <Error Text="manifest.json not found in Thunderstore directory." Condition="!Exists('$(ProjectDir)Thunderstore\manifest.json')"/>
        <RemoveDir Directories="$(PackageDir)" Condition="Exists('$(PackageDir)')"/>
        <MakeDir Directories="$(PackageDir)"/>
        <Copy SourceFiles="$(ProjectDir)README.md" DestinationFolder="$(PackageDir)" OverwriteReadOnlyFiles="true"/>
        <Copy SourceFiles="$(ProjectDir)translations\English.yml" DestinationFiles="$(PackageDir)\$(AssemblyName).English.yml" OverwriteReadOnlyFiles="true"/>
        <Copy SourceFiles="$(ProjectDir)Thunderstore\manifest.json" DestinationFiles="$(PackageDir)\manifest.json" OverwriteReadOnlyFiles="true"/>
    </Target>
    <Target Name="UpdateManifestVersion" AfterTargets="CopyReadMeToTSFolder" Condition=" ('$(Configuration)|$(Platform)' == 'Release|AnyCPU') And ('$(OS)' == 'Windows_NT') ">
        <ItemGroup>
            <ManifestFile Include="$(PackageDir)\manifest.json"/>
        </ItemGroup>
        <Message Text="Updating version number in staged Thunderstore manifest: @(ManifestFile)"/>
        <Exec Command="powershell.exe -ExecutionPolicy Bypass -Command &quot;&amp; { &amp; '$(ProjectDir)UpdateManifest.ps1' -manifestFile '@(ManifestFile)' -versionString '$(PackageVersion)' }&quot;"/>
    </Target>
    <Target Name="MakeThunderstorePackage" AfterTargets="UpdateManifestVersion" Condition=" ('$(Configuration)|$(Platform)' == 'Release|AnyCPU') And ('$(OS)' == 'Windows_NT') ">
        <Error Text="Staged manifest.json not found in package directory." Condition="!Exists('$(PackageDir)\manifest.json')"/>
        <Error Text="icon.png not found in Thunderstore directory. Please note that Thunderstore requires this image to be 256x256 in dimension" Condition="!Exists('$(ProjectDir)\Thunderstore\icon.png')"/>
        <ItemGroup>
            <PackageFiles Include="$(TargetDir)$(AssemblyName).dll" Condition="Exists('$(TargetDir)$(AssemblyName).dll')"/>
            <PackageFiles Include="$(ProjectDir)\Thunderstore\CHANGELOG.md" Condition="Exists('$(ProjectDir)\Thunderstore\CHANGELOG.md')"/>
            <PackageFiles Include="$(ProjectDir)\Thunderstore\icon.png" Condition="Exists('$(ProjectDir)\Thunderstore\icon.png')"/>
            <PackageFiles Include="$(ProjectDir)THIRD_PARTY_NOTICES.txt"/>
        </ItemGroup>
        <MakeDir Directories="$(PackageDir)"/>
        <Copy SourceFiles="@(PackageFiles)"
              DestinationFiles="@(PackageFiles->'$(PackageDir)\%(RecursiveDir)%(Filename)%(Extension)')"/>
        <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="Thunderstore\$(PackageName).zip" Overwrite="true"/>
        <RemoveDir Directories="$(PackageDir)"/>
    </Target>
    <Target Name="MakeNexusPackage" AfterTargets="MakeThunderstorePackage" Condition=" ('$(Configuration)|$(Platform)' == 'Release|AnyCPU') And ('$(OS)' == 'Windows_NT') ">
        <MakeDir Directories="$(ProjectDir)\Nexus"/>
        <ItemGroup>
            <NexusPackageFiles Include="$(TargetDir)$(AssemblyName).dll" Condition="Exists('$(TargetDir)$(AssemblyName).dll')"/>
            <NexusPackageFiles Include="$(ProjectDir)THIRD_PARTY_NOTICES.txt"/>
        </ItemGroup>
        <MakeDir Directories="$(PackageDir)"/>
        <Copy SourceFiles="@(NexusPackageFiles)"
              DestinationFiles="@(NexusPackageFiles->'$(PackageDir)\%(RecursiveDir)%(Filename)%(Extension)')"/>
        <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="Nexus\$(PackageName).zip" Overwrite="true"/>
        <RemoveDir Directories="$(PackageDir)"/>
    </Target>

</Project>
