    <Import Project="environment.local.props" Condition="Exists('environment.local.props')"/>
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <ProjectGuid>{4358610B-F3F4-4843-B7AF-98B7BC60DCDE}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>STUWard</RootNamespace>
        <AssemblyName>STUWard</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>win</RuntimeIdentifiers>
        <DeployLocal Condition="'$(DeployLocal)' == ''">false</DeployLocal>
        <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
        <GamePluginDeployPath Condition="'$(GamePluginDeployPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\plugins</GamePluginDeployPath>
        <RestoreSources>$(RestoreSources);$(MSBuildProjectDirectory)\LocalPackages</RestoreSources>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
